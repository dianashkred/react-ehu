{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "moduleResolution": "Node",
      "strict": true,
      "jsx": "react-jsx",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "baseUrl": "./",
      "paths": {
      "@assets/*": ["src/assets/*"],
      "@components/*": ["src/components/*"]
      }
    },
    "include": ["src","src/global.d.ts"],
    "exclude": ["node_modules"]
  
  
}
